# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/leader_sport?schema=public"

# Used to build the return URL the customer lands on after paying
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret (or `openssl rand -base64 32`)
AUTH_SECRET=""
# Only needed when NOT deploying to Vercel and not on a standard https origin
# AUTH_TRUST_HOST=true

# PIN required in the admin UI to reveal/edit a product's cost price.
COST_PRICE_PIN=""

# Whish Pay (Whish wallet + Visa/Mastercard via their hosted checkout).
# Not usable until you have a real Whish merchant account — see
# src/lib/payments/whish.ts for details on what's still unverified.
WHISH_API_BASE_URL=""
WHISH_API_SECRET=""

# Cloudinary (product images) — UNUSED. Cloudinary's sign-up geo-blocked
# this account's location (2026-09-22), so product photo uploads switched
# to Vercel Blob instead (below). Left here in case that ever changes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase Auth (Google + phone/SMS login) — from the Firebase console's
# Project settings > General > Your apps > SDK setup and configuration.
# These are all client-safe values (Firebase's own design — access control
# happens via provider settings/Security Rules, not by hiding this config),
# but still env-configurable rather than hardcoded. See
# src/lib/firebase/client.ts and src/auth.ts's "firebase" provider.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK — UNUSED. Was going to sign direct-to-Storage upload
# URLs (src/lib/firebase/admin.ts) as a Cloudinary replacement, but Firebase
# Storage itself needs a Google Cloud Blaze billing account to provision a
# bucket at all, and that billing setup failed with an unresolved Google-
# side account error (2026-09-22) — switched to Vercel Blob instead
# (below). Left here in case the Google billing issue ever gets resolved.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=""

# Vercel Blob (product image uploads) — the admin's browser uploads photos
# straight to Blob storage via a short-lived token minted by
# src/app/api/upload/route.ts (product.imageUploadSignature is gone; this
# is a plain Route Handler, not a tRPC procedure). Setup:
# 1. Vercel dashboard > your project > Storage tab > Create Database >
#    Blob > pick a store name (e.g. "kickoff-images") > Create.
# 2. Vercel offers to connect it to this project automatically — accept
#    that, and it injects BLOB_READ_WRITE_TOKEN into your Vercel env vars
#    for you (Production + Preview). For local dev, copy that same value:
#    Storage tab > your Blob store > .env.local tab > copy the value.
# On Vercel's Hobby plan this is genuinely free, no card required at all
# (hard-capped, not pay-as-you-go): 1GB storage, 10GB data transfer, 10,000
# simple + 2,000 advanced operations per month — plenty for product photos
# on a small catalog. (If this project is on a paid Pro plan instead, Blob
# usage is billed from the existing monthly credit — still ~$0 at this
# scale. Either way, no NEW billing relationship needed, unlike Google's
# Blaze requirement for Firebase Storage above.)
BLOB_READ_WRITE_TOKEN=""

# WhatsApp order notifications via Meta's official WhatsApp Business Cloud
# API (src/lib/notify-order.ts, called from order.checkout). Setup:
# 1. developers.facebook.com > My Apps > Create App > type "Business".
# 2. Add the "WhatsApp" product. It provisions a free test number and a
#    temporary access token immediately — good enough to verify wiring.
# 3. WhatsApp > API Setup page: copy the "Phone number ID" into
#    WHATSAPP_PHONE_NUMBER_ID below. Add your own phone as a recipient
#    (test numbers require allow-listing recipients) and copy it, digits
#    only with country code, into WHATSAPP_OWNER_NUMBER.
# 4. For a token that doesn't expire in 24h: Business Settings > Users >
#    System Users > create one > generate a permanent token with
#    whatsapp_business_messaging permission > WHATSAPP_ACCESS_TOKEN below.
# 5. Business-initiated messages need an approved template (free-form text
#    isn't allowed outside a 24h customer-reply window). WhatsApp Manager >
#    Message Templates > Create Template, category UTILITY, body:
#      "New order from {{1}}! Items: {{2}}. Total: {{3}}. Order ID: {{4}}."
#    Name it (e.g. order_notification) and put that exact name in
#    WHATSAPP_TEMPLATE_NAME. Utility templates are usually approved within
#    minutes. Until approved, you can smoke-test delivery with the
#    pre-approved sample template "hello_world" (en_US) instead — it won't
#    include order details, just confirms the token/number/wiring work.
# Entirely optional: unset, this silently does nothing
# (src/lib/notify-order.ts no-ops), same as the WhatsApp notifier below.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OWNER_NUMBER=""
WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANG=""  # defaults to en_US if unset

# Earlier WhatsApp order-notification attempt (see whatsapp-notifier/README.md)
# — DORMANT, not called from anywhere. Used an unofficial library
# impersonating WhatsApp Web from a personal number; dropped 2026-08-07
# after fighting WhatsApp's anti-bot rate-limiting, superseded 2026-09-22 by
# the official Meta Cloud API above. whatsapp-notifier/ still exists,
# deliberately left in place rather than deleted, in case this is ever
# revisited. Setting these currently does nothing.
NOTIFY_ORDER_URL=""
NOTIFY_ORDER_SECRET=""

# Browser push notifications for the admin panel (Web Push API) — replaces
# the WhatsApp notifier above. Generate a real key pair with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose client-side (that's the
# point of the public/private split); VAPID_PRIVATE_KEY is server-only and
# must be kept secret. VAPID_SUBJECT identifies the sender to push
# services per the Web Push spec — a mailto: or https: URL, e.g.
# "mailto:you@example.com". Checkout works fine without these set
# (src/lib/push-notify.ts silently no-ops) — this is optional.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
